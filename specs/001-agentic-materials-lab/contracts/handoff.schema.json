{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/handoff.schema.json",
  "title": "Handoff envelope",
  "type": "object",
  "required": ["run_id", "round", "from_agent", "to_agent", "payload", "citations"],
  "properties": {
    "run_id": {"type": "string", "minLength": 1},
    "round": {"type": "integer", "minimum": 0},
    "from_agent": {
      "type": "string",
      "enum": ["literature", "insight", "planner", "runner", "analysis", "record", "safety", "scientist"]
    },
    "to_agent": {
      "type": "string",
      "enum": ["literature", "insight", "planner", "runner", "analysis", "record", "safety", "scientist"]
    },
    "payload": {
      "oneOf": [
        {"$ref": "#/definitions/LiteratureClaims"},
        {"$ref": "#/definitions/InsightHypotheses"},
        {"$ref": "#/definitions/ExperimentSpec"},
        {"$ref": "#/definitions/RunResult"},
        {"$ref": "#/definitions/AnalysisVerdict"},
        {"$ref": "#/definitions/ApprovalRequest"},
        {"$ref": "#/definitions/ApprovalDecision"}
      ]
    },
    "citations": {"type": "array", "items": {"type": "string"}},
    "uncertainty": {"type": ["string", "null"], "enum": ["low", "medium", "high", null]}
  },
  "definitions": {
    "Citation": {
      "type": "object",
      "required": ["id", "claim", "source_title", "doi_or_url", "year", "cached_response_id"],
      "properties": {
        "id": {"type": "string"},
        "claim": {"type": "string", "minLength": 1},
        "source_title": {"type": "string", "minLength": 1},
        "doi_or_url": {"type": "string", "minLength": 1},
        "year": {"type": "integer"},
        "cached_response_id": {"type": "string"}
      }
    },
    "LiteratureClaims": {
      "type": "object",
      "required": ["claims"],
      "properties": {"claims": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/Citation"}}}
    },
    "Hypothesis": {
      "type": "object",
      "required": ["id", "label", "statement", "testable_feature_set", "predicted_direction", "supporting_citation_ids"],
      "properties": {
        "id": {"type": "string"},
        "label": {"const": "AGENT-GENERATED"},
        "statement": {"type": "string", "minLength": 1},
        "testable_feature_set": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "predicted_direction": {"enum": ["positive", "negative"]},
        "supporting_citation_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "InsightHypotheses": {
      "type": "object",
      "required": ["hypotheses"],
      "properties": {"hypotheses": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/Hypothesis"}}}
    },
    "RejectedAlternative": {
      "type": "object",
      "required": ["strategy", "reason"],
      "properties": {
        "strategy": {"enum": ["exploit", "explore", "hybrid", "hypothesis_test"]},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "ExperimentSpec": {
      "type": "object",
      "required": ["round", "strategy", "batch_ids", "rationale", "expected_learning", "cost", "rejected_alternatives"],
      "properties": {
        "round": {"type": "integer", "minimum": 1},
        "strategy": {"enum": ["exploit", "explore", "hybrid", "hypothesis_test"]},
        "batch_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "rationale": {"type": "string", "minLength": 1},
        "expected_learning": {"type": "string", "minLength": 1},
        "cost": {"type": "integer", "minimum": 1},
        "rejected_alternatives": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/RejectedAlternative"}}
      }
    },
    "RunResult": {
      "type": "object",
      "required": ["batch_ids", "true_values", "hits_in_batch", "cumulative_hits", "budget_remaining", "run_id", "seed"],
      "properties": {
        "batch_ids": {"type": "array", "items": {"type": "string"}},
        "true_values": {"type": "array", "items": {"type": "number"}},
        "hits_in_batch": {"type": "integer", "minimum": 0},
        "cumulative_hits": {"type": "integer", "minimum": 0},
        "budget_remaining": {"type": "integer", "minimum": 0},
        "run_id": {"type": "string"},
        "seed": {"type": "integer"}
      }
    },
    "HypothesisVerdict": {
      "type": "object",
      "required": ["id", "verdict"],
      "properties": {
        "id": {"type": "string"},
        "verdict": {"enum": ["supported", "refuted", "inconclusive"]},
        "evidence": {"type": "string"}
      },
      "allOf": [{
        "if": {"properties": {"verdict": {"const": "inconclusive"}}},
        "then": {},
        "else": {"required": ["evidence"]}
      }]
    },
    "AnalysisVerdict": {
      "type": "object",
      "required": ["hypothesis_verdicts"],
      "properties": {
        "hypothesis_verdicts": {"type": "array", "items": {"$ref": "#/definitions/HypothesisVerdict"}},
        "strategy_recommendation": {"enum": ["switch_to_explore", "switch_to_hybrid", "switch_to_exploit", "continue", null]},
        "reason": {"type": "string"}
      },
      "if": {"properties": {"hypothesis_verdicts": {"contains": {"properties": {"verdict": {"const": "refuted"}}, "required": ["verdict"]}}}},
      "then": {"required": ["strategy_recommendation", "reason"]}
    },
    "ApprovalRequest": {
      "type": "object",
      "required": ["action", "justification"],
      "properties": {
        "action": {"enum": ["recommend_for_validation", "budget_increase", "report_uncited_claim"]},
        "justification": {"type": "string", "minLength": 1}
      }
    },
    "ApprovalDecision": {
      "type": "object",
      "required": ["action", "approved", "approver"],
      "properties": {
        "action": {"enum": ["recommend_for_validation", "budget_increase", "report_uncited_claim"]},
        "approved": {"type": "boolean"},
        "approver": {"type": "string", "minLength": 1}
      }
    }
  }
}
