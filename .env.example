# Copy to .env and fill in. .env is gitignored; .env is auto-loaded by src/llm.py.
# Real environment variables always win over .env file values.

# --- Provider selection ------------------------------------------------------
# engine (default, deterministic, no network) | openai | anthropic
LLM_PROVIDER=engine

# --- OpenAI-compatible providers (LLM_PROVIDER=openai) ------------------------
# Model name or serving-endpoint name.
#LLM_MODEL=gpt-4o-mini

# Endpoint base URL. Two API styles supported:
#   .../chat/completions style -> set base WITHOUT the suffix, e.g.:
#LLM_BASE_URL=https://api.openai.com/v1
#   OpenAI Responses API style -> set the full .../responses URL, e.g. OpenCode Zen:
#LLM_BASE_URL=https://opencode.ai/zen/v1/responses

# API key (or use the provider-specific vars below).
#LLM_API_KEY=
#OPENAI_API_KEY=
#OPENAI_BASE_URL=

# --- Anthropic (LLM_PROVIDER=anthropic) ---------------------------------------
#LLM_MODEL=claude-haiku-4-5
#ANTHROPIC_API_KEY=
#ANTHROPIC_BASE_URL=https://api.anthropic.com

# --- OpenCode Zen subscription (copy-paste preset, LLM_PROVIDER=openai) -------
#LLM_PROVIDER=openai
#LLM_BASE_URL=https://opencode.ai/zen/v1/responses
#LLM_API_KEY=<your-zen-api-key>
#LLM_MODEL=gpt-5.4-mini

# --- Databricks serving endpoint (LLM_PROVIDER=openai preset) -----------------
#LLM_PROVIDER=openai
#LLM_BASE_URL=https://<workspace-url>/serving-endpoints
#LLM_API_KEY=<databricks-PAT>
#LLM_MODEL=<serving-endpoint-name>
